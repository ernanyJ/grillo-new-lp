---
import Icone from "@/components/ui/Icone.astro";
import { site, type PosicaoCta } from "@/config/site";

/**
 * Botões — dois níveis, e a hierarquia não se mistura.
 *
 *   primaria   — âmbar com texto escuro, Plus Jakarta 800, altura mínima de
 *                56 px, ícone do WhatsApp, brilho que atravessa e leve atração
 *                ao cursor (`data-magnetico`). É a conversa, sempre.
 *   secundaria — pílula de contorno, para navegar dentro da página.
 *
 * Sem `href`, o botão abre o WhatsApp. Todo botão é um <a> de verdade.
 */
interface Props {
  href?: string;
  posicao?: PosicaoCta;
  variant?: "primaria" | "secundaria";
  size?: "padrao" | "compacto" | "grande";
  block?: boolean;
  icone?: boolean;
  class?: string;
}
const {
  href,
  posicao,
  variant = "primaria",
  size = "padrao",
  block = false,
  icone = true,
  class: className = "",
}: Props = Astro.props;

const whatsapp = !href;
const destino = href ?? site.whatsapp.href;

const tamanhos = {
  compacto: "min-h-11 px-5 py-2.5 text-[0.75rem] tracking-[0.06em]",
  padrao: "min-h-14 px-7 py-4 text-[0.875rem] tracking-[0.05em] sm:text-[0.9375rem]",
  grande: "min-h-16 px-9 py-5 text-[0.9375rem] tracking-[0.05em] sm:text-base",
};

const primaria = [
  "group relative isolate inline-flex items-center justify-center gap-3 overflow-hidden rounded-full text-center",
  "bg-linear-[180deg,var(--color-ambar-claro),var(--color-ambar)_55%,var(--color-ambar-fundo)]",
  "font-texto leading-tight font-extrabold text-sobre-ambar uppercase",
  "shadow-media inset-shadow-[0_1px_0_rgb(255_255_255/0.55)] brilho-varrer",
  "transition-[box-shadow,filter] duration-300 ease-suave",
  "hover:shadow-ambar hover:brightness-105",
  tamanhos[size],
  block ? "w-full" : "w-full sm:w-auto",
].join(" ");

const secundaria = [
  "group inline-flex items-center justify-center gap-2.5 rounded-full",
  "border border-linha-2 bg-card/60 px-6 py-3 min-h-12 backdrop-blur",
  "font-texto text-[0.875rem] font-bold text-creme-2",
  "transition-[background-color,border-color,color,transform] duration-300 ease-suave",
  "hover:border-ambar-fundo hover:text-ambar-claro hover:-translate-y-0.5",
  block ? "w-full" : "w-full sm:w-auto",
].join(" ");
---

<a
  href={destino}
  class:list={[variant === "primaria" ? primaria : secundaria, className]}
  data-cta={posicao}
  data-magnetico={variant === "primaria" ? "" : undefined}
  target={whatsapp ? "_blank" : undefined}
  rel={whatsapp ? "noopener" : undefined}
>
  {
    icone && whatsapp && variant === "primaria" && (
      <span class="grid size-7 shrink-0 place-items-center rounded-full bg-sobre-ambar/90 text-ambar-claro transition-transform duration-500 ease-mola group-hover:rotate-[360deg]">
        <Icone name="whatsapp" class="size-4" />
      </span>
    )
  }
  <span><slot /></span>
  {
    icone && (
      <Icone
        name="seta"
        class="size-4 transition-transform duration-300 ease-mola group-hover:translate-x-1"
        espessura={2.25}
      />
    )
  }
</a>
