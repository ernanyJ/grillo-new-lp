---
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Button from "@/components/ui/Button.astro";
import Destaque from "@/components/ui/Destaque.astro";
import Icone from "@/components/ui/Icone.astro";
import { provas, cta } from "@/data/landing";

/**
 * Provas logo depois do hero: a autoridade vem antes do discurso. Os números
 * contam ao entrar (`data-contar`) — o valor final já está no HTML.
 */
const [destaque, ...demais] = provas.numeros;
---

<Section id="provas" tone="fundo-2" filetes>
  <SectionHeading
    rotulo={provas.rotulo}
    title={provas.title}
    destaque={provas.destaque}
    subtitle={provas.subtitle}
  />

  <div class="mt-14 grid gap-4 lg:grid-cols-[1.1fr_2fr]">
    <!-- Número principal: o tempo recorde, em cartão âmbar com anel girando. -->
    <article
      data-reveal="escala"
      class="holofote relative flex flex-col justify-between overflow-hidden rounded-bloco border border-ambar-fundo/60 bg-linear-[160deg,var(--color-card-2),var(--color-fundo)] p-8 shadow-alta"
    >
      <svg aria-hidden="true" class="absolute -top-24 -right-24 size-72 girar" style="--dur: 30s" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="96" stroke="rgb(246 162 0 / 0.35)" stroke-dasharray="3 9" />
        <circle cx="100" cy="100" r="70" stroke="rgb(147 191 191 / 0.2)" stroke-dasharray="40 12" />
      </svg>
      <p class="relative rotulo text-ambar-claro">{destaque.tag}</p>
      <p class="relative mt-10 numero text-[7rem] text-creme sm:text-[9rem]">
        <span data-contar={destaque.valor}>{destaque.valor}</span><span class="titulo-destaque text-[0.45em]">{destaque.sufixo}</span>
      </p>
      <p class="relative mt-4 max-w-[26ch] font-texto text-lg leading-snug text-creme-2">{destaque.label}</p>
    </article>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        demais.map((n, i) => (
          <article
            data-reveal
            style={`--i: ${i + 1}`}
            class="holofote group relative overflow-hidden rounded-bloco border border-linha bg-card p-7 transition-colors duration-500 hover:border-ambar-fundo/60"
          >
            <p class="rotulo text-fosco">{n.tag}</p>
            <p class="mt-6 numero text-[4.2rem] text-creme sm:text-[5rem]">
              {n.prefixo && <span class="text-[0.55em] text-ambar">{n.prefixo}</span>}
              <span data-contar={n.valor}>{n.valor}</span>
              {n.sufixo && (n.sufixo.length > 3
                ? <span class="mt-1 block text-[0.42em] text-ambar">{n.sufixo.trim()}</span>
                : <span class="text-[0.7em] text-ambar">{n.sufixo}</span>)}
            </p>
            <p class="mt-3 font-texto text-[0.9375rem] leading-snug text-fosco">{n.label}</p>
            <span aria-hidden="true" class="absolute right-6 bottom-6 h-px w-10 origin-right scale-x-50 bg-ambar transition-transform duration-500 group-hover:scale-x-150" />
          </article>
        ))
      }
    </div>
  </div>

  <div data-reveal class="mt-14 flex flex-col items-center gap-8 text-center">
    <div class="flex items-center gap-4">
      <span aria-hidden="true" class="h-px w-12 bg-linear-to-r from-transparent to-ambar"></span>
      <p class="rotulo text-ambar">{provas.filosofia.rotulo}</p>
      <span aria-hidden="true" class="h-px w-12 bg-linear-to-l from-transparent to-ambar"></span>
    </div>
    <p class="max-w-[30ch] titulo text-[1.9rem] text-creme sm:text-[2.6rem]">
      <Icone name="aspas" class="mr-2 inline size-8 -translate-y-2 text-ambar/60" />
      <Destaque texto={provas.filosofia.text} destaque={provas.filosofia.destaque} />
    </p>
    <Button posicao="provas">{cta.falar}</Button>
  </div>
</Section>
