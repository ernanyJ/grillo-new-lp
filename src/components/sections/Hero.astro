---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import Pilula from "@/components/ui/Pilula.astro";
import Icone from "@/components/ui/Icone.astro";
import Destaque from "@/components/ui/Destaque.astro";
import SimboloGirando from "@/components/ui/SimboloGirando.astro";
import { hero, cta } from "@/data/landing";

/**
 * Primeira dobra: rótulo, headline que sobe palavra por palavra, um parágrafo,
 * os dois botões e a prova curta (avaliações e ranking). À direita, o símbolo
 * girando com as oito frentes em órbita.
 *
 * O segundo parágrafo do site atual ("Não somos uma agência comum…") foi para
 * a seção "O que é", onde vira comparação visual.
 *
 * `data-hero` é o marco dos CTAs fixos.
 */
const orbitas = ["Branding", "IA", "Sistemas", "UX/UI", "Copy", "Vendas", "Dados", "Educação"];
---

<section id="topo" data-hero class="relative isolate overflow-hidden bg-fundo">
  <!-- Fundo vivo: grade técnica e duas manchas de luz à deriva. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 grade"></div>
    <div data-profundidade="-30" class="absolute -top-40 -left-40 size-[36rem]">
      <div class="size-full rounded-full bg-floresta/70 blur-[120px] deriva" style="--dur: 24s"></div>
    </div>
    <div data-profundidade="40" class="absolute top-1/3 -right-32 size-[28rem]">
      <div class="size-full rounded-full bg-ambar/15 blur-[110px] deriva" style="--dur: 18s; --atraso: -6s"></div>
    </div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-linear-to-b from-transparent to-fundo"></div>
  </div>

  <Container class="grid items-center gap-14 pt-12 pb-20 sm:pt-20 lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-10 lg:pt-10 lg:pb-24">
    <div class="text-center lg:text-left">
      <div data-reveal="escala">
        <Pilula>{hero.rotulo}</Pilula>
      </div>

      <h1
        data-reveal
        data-palavras
        class="mx-auto mt-6 max-w-[20ch] titulo text-[2.75rem] text-creme sm:text-[4rem] lg:mx-0 lg:text-[4.4rem] xl:text-[4.9rem]"
      >
        <Destaque texto={hero.title} destaque={hero.destaque} />
      </h1>

      <p
        data-reveal
        style="--atraso: 450ms"
        class="mx-auto mt-6 max-w-[50ch] texto text-pretty text-creme-2 sm:text-lg lg:mx-0"
      >
        {hero.paragrafo}
      </p>

      <div
        data-reveal
        style="--atraso: 600ms"
        class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start"
      >
        <Button posicao="hero" size="grande">{cta.falar}</Button>
        <Button href="#solucoes" variant="secundaria">{cta.verSolucoes}</Button>
      </div>

      <div
        data-reveal
        style="--atraso: 750ms"
        class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 lg:justify-start"
      >
        <p class="flex items-center gap-3">
          <span class="flex text-ambar" aria-label="5 estrelas">
            {[0, 1, 2, 3, 4].map((i) => (
              <Icone name="estrela" class="size-4 [animation:piscar_3s_ease-in-out_infinite]" style={`animation-delay:${i * 0.2}s`} />
            ))}
          </span>
          <span class="font-texto text-sm text-creme-2">
            <strong class="font-bold text-creme">{hero.prova.avaliacoes}</strong> · {hero.prova.recorrentes}
          </span>
        </p>
        <span aria-hidden="true" class="hidden h-5 w-px bg-linha-2 sm:block"></span>
        <p class="font-texto text-sm text-creme-2">
          <strong class="font-bold text-ambar-claro">{hero.prova.ranking}</strong> / {hero.prova.plataforma}
        </p>
      </div>
    </div>

    <div data-reveal="girar" style="--atraso: 300ms" class="mx-auto w-full max-w-[16.5rem] sm:max-w-[26rem] lg:max-w-[32rem]">
      <div data-profundidade="-14">
        <SimboloGirando anel={hero.anel} orbitas={orbitas} />
      </div>
    </div>
  </Container>

</section>
