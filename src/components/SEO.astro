---
import { site } from "@/config/site";
import { withBase } from "@/config/base";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  noindex = false,
} = Astro.props;

/* O canonical aponta sempre para o endereço definitivo, mesmo no preview do
   GitHub Pages — que por isso também sai com `noindex`. */
const rota = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/").replace(/\/{2,}/g, "/");
const canonical = new URL(rota, site.domain).toString();
const imageUrl = new URL(image, Astro.site ?? site.domain).toString();
const ehPreview = (Astro.site?.origin ?? site.domain) !== site.domain;
const imageAlt = `${site.name} · ${site.descritorCompleto}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(noindex || ehPreview) && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href={withBase("/favicon-32.png")} type="image/png" sizes="32x32" />
<link rel="icon" href={withBase("/icon-512.png")} type="image/png" sizes="512x512" />
<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180" />
<meta name="theme-color" content="#04110B" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="pt_BR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
